  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PuzzleBlood
  player: {fileID: 0}
  lookAtBlood:
  - 'Eep! There''s b-blood! '
  - It looks... fresh. W-who did it belong to?
  - I-I shouldn't stay here any longer.
  needACup:
  - Ugh... I guess I need to use this blood to water the plant.
  - ...there's no way in hell I'm touching it. Maybe there's something I can use
    to scoop it up.
  getBlood:
  - Alright, I'll use this cup to scoop the blood.
  - Carefully...I don't wanna ruin this dress...
  - Got it. Time to water the plant.
  bloodDone:
  - ...there's still some blood left. Ugh...
  - I always get squeamish around blood, especially if it's not mine.
  - ...I should go.
  inspectBox: {fileID: 7904412447652946779, guid: 0be65b79d00884b40aed91eddc23e790, type: 3}
  boxCollider: {fileID: 875304229}
  mainCamera: {fileID: 0}
