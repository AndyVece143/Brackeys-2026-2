  m_Script: {fileID: 11500000, guid: cdcf4ed7b0c85fc4eb0d638eb52a7c6a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PuzzleChair
  player: {fileID: 0}
  getReadingList:
  - A nice chair. I guess this was used for reading. In more comfortable circumstances,
    I'd love to read here.
  - Ya know, things always get lost inbetween the cushions. I wonder if something
    is in here.
  - ...........hmm? I found a list. It's labeled 'Reading List". Most of the books
    are crossed out.
  - The only book not crossed out is "How to Care for Strange Plants". I wonder if
    I can find that book somewhere.
  readingListGot:
  - There doesn't appear to be anything else inbetween the cushions.
  - I need to find a book called "How to Care for Strange Plants".
  inspectBox: {fileID: 7904412447652946779, guid: 0be65b79d00884b40aed91eddc23e790, type: 3}
  boxCollider: {fileID: 790975058}
  mainCamera: {fileID: 0}
