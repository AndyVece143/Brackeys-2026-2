  m_Script: {fileID: 11500000, guid: 58f7394b86c875b488d50eb2d41de6ed, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractableObject
  player: {fileID: 0}
  dialogue1:
  - A bookshelf. I wonder what kind of books are here.
  - Hmm? This book is yuri. I've read this one, it's really good.
  - Huh? These books over here are also yuri. Wow, some of these are old.
  - ...oh my god, this entire shelf is full of yuri. It's all yuri.
  - ...I kind of want to take these for myself.
  dialogue2:
  - Something tells me that the secret to getting out of here will not be found in
    the yuri.
  - Unless, of course, the secret is that I have to kiss the ghost girl.
  - ....................................
  - 'O-of course that won''t work! '
  inspectBox: {fileID: 7904412447652946779, guid: 0be65b79d00884b40aed91eddc23e790, type: 3}
  boxCollider: {fileID: 257033299}
  react: 1
