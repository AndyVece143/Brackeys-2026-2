PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1899309825}
    m_Modifications:
    - target: {fileID: 2615303210128171141, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: death
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 2615303210128171141, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: dialogue1.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 2615303210128171141, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: 'dialogue1.Array.data[0]'
      value: Oh hey, there's a book here. It appears to be a diary. I bet there's
        a clue inside.
      objectReference: {fileID: 0}
    - target: {fileID: 2615303210128171141, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: 'dialogue1.Array.data[1]'
      value: '''August 25th: My second year of college started today, and things
        are already very interesting.'''
      objectReference: {fileID: 0}
    - target: {fileID: 2615303210128171141, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: 'dialogue1.Array.data[2]'
      value: '''I went to my Psychology 101 class (I needed a gen ed credit and it
        looked fun), and saw a really cute girl.'''
      objectReference: {fileID: 0}
    - target: {fileID: 2615303210128171141, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: 'dialogue1.Array.data[3]'
      value: '''I decided to sit next to her, and she noticed one of the pins on
        my backpack, and we started talking.'''
      objectReference: {fileID: 0}
    - target: {fileID: 2615303210128171141, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: 'dialogue1.Array.data[4]'
      value: '''We connected very quickly. I know we only just met, but I felt something
        between us.'' '
      objectReference: {fileID: 0}
    - target: {fileID: 2615303210128171141, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: 'dialogue1.Array.data[5]'
      value: '''After class, I asked for her number, and then the craziest thing
        happened!'''
      objectReference: {fileID: 0}
    - target: {fileID: 3597252035074719195, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: m_Name
      value: Interactable Object
      objectReference: {fileID: 0}
