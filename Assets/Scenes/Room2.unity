--- !u!1001 &1385836028
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1108433648}
    m_Modifications:
    - target: {fileID: 2615303210128171141, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: dialogue1.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 2615303210128171141, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: dialogue2.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 2615303210128171141, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: 'dialogue1.Array.data[0]'
      value: Ooh, what a nice couch! Perfect for watching TV or taking a nap.
      objectReference: {fileID: 0}
    - target: {fileID: 2615303210128171141, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: 'dialogue1.Array.data[1]'
      value: 'I should check inbetween the cushions for anything. There''s always
        something in couch cushions. '
      objectReference: {fileID: 0}
    - target: {fileID: 2615303210128171141, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: 'dialogue1.Array.data[2]'
      value: .........................there's nothing. Rats.
      objectReference: {fileID: 0}
    - target: {fileID: 2615303210128171141, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: 'dialogue2.Array.data[0]'
      value: 'It''s interesting that she has a two person couch in her room. '
      objectReference: {fileID: 0}
    - target: {fileID: 2615303210128171141, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: 'dialogue2.Array.data[1]'
      value: 'Maybe she frequently had a friend over and they both sat here to watch
        TV. '
      objectReference: {fileID: 0}
    - target: {fileID: 2615303210128171141, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: 'dialogue2.Array.data[2]'
      value: ...poor girl probably hasn't had a friend in a long time...
      objectReference: {fileID: 0}
    - target: {fileID: 3597252035074719195, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: m_Name
      value: Interactable Object
      objectReference: {fileID: 0}
    - target: {fileID: 6671789510596350034, guid: 0658a3366fc0ea044a1404403502f174, type: 3}
      propertyPath: m_LocalScale.x
      value: 3.9626
      objectReference: {fileID: 0}
